# Environment variables must be set in your shell; this file is a reference.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
RENTAL_CURRENCY=EGP
# For deployment: use a unique secret, DJANGO_DEBUG=false, HTTPS, and a production server.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
